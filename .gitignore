# ============================================
# OptiGradTrust .gitignore
# ============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
.env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebook
.ipynb_checkpoints

# ============================================
# Data - NEVER track datasets in git
# ============================================
data/
*.pkl
*.h5
*.npy
*.npz
*.mat
*.csv
*.tsv
oasis_cross-sectional.xlsx

# ============================================
# Model weights - too large for git
# ============================================
model_weights/
*.pt
*.pth
*.ckpt
*.pb
*.onnx
*.tflite
*.lite
*.trt

# ============================================
# Results - generated by experiments
# ============================================
# Ignore contents of results/ (not the folder itself) so negations can apply
results/*
*.json
*.jsonl
# Exception: publication results for paper (reviewer verification)
!results/reviewer_experiments/
!results/reviewer_experiments/**
!results/reviewer_experiments/**/*.json
!results/reviewer_experiments/**/*.md
# Do not commit large run logs (keep repo lean)
results/reviewer_experiments/**/experiment_log_*.txt
results/reviewer_experiments/**/optimized_log_*.txt

# ============================================
# Logs and output
# ============================================
logs/
*.log
*.out
output.txt

# ============================================
# Images and media (generated plots, etc.)
# ============================================
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.ico
*.svg
*.mp4
*.avi
*.mov
*.pdf

# ============================================
# Backup and old files
# ============================================
*.bak
*.backup
*_backup.*
backups/
federated_learning/training/backups/

# ============================================
# Old/unused scripts (kept locally for reference)
# ============================================
run_fltrust_experiments.*
run_oasis_experiments.py

# ============================================
# Internal documentation (not for public repo)
# ============================================
REVISION_EXPERIMENTS_REPORT.md
SERVER_INSTRUCTIONS.md
SERVER_SYNC_GUIDE.md
COMPLETE_VALIDATION_REPORT.md
FINAL_VALIDATION_REPORT.md
PUSH_TO_GITHUB_GUIDE.md
FINAL_SUMMARY_FOR_PUSH.md
GITHUB_PREPARATION_PLAN.md
verify_before_run.py

# Internal experiment runs (not for publication)
new_experiment/
new_results/

# ============================================
# Old/unused config files
# ============================================
federated_learning/config/config_oasis.py
federated_learning/config/config_optimized.py

# ============================================
# OS generated files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# Large binary files
# ============================================
*.bin
*.dat
*.db
*.sqlite
*.sqlite3

# ============================================
# Temporary files
# ============================================
*.tmp
*.temp
*~

# ============================================
# Cache directories
# ============================================
.cache/
.pytest_cache/

# ============================================
# Test and debug files
# ============================================
test_*.py
debug_*.py
comprehensive_validation_*.json
training_metrics_*.pt
training_progress_*.png
